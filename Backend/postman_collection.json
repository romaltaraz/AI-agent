{
  "info": {
    "name": "Hebrew AI Chat API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run 'Create conversation' first - it saves conversationId for the other requests."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "conversationId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Create conversation",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/conversations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('conversationId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List conversations",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/conversations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations"
          ]
        }
      }
    },
    {
      "name": "Search conversations by title",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/conversations?search=שיחה",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations"
          ],
          "query": [
            {
              "key": "search",
              "value": "שיחה"
            }
          ]
        }
      }
    },
    {
      "name": "Get conversation with messages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    },
    {
      "name": "Send message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"שלום! תסביר לי במשפט אחד מה זה FastAPI\"\n}"
        }
      }
    },
    {
      "name": "Send message - empty (expect 422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"   \"\n}"
        }
      }
    },
    {
      "name": "Get missing conversation (expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "999999"
          ]
        }
      }
    },
    {
      "name": "Delete conversation",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/conversations/{{conversationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "conversations",
            "{{conversationId}}"
          ]
        }
      }
    }
  ]
}