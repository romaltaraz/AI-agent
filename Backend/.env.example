# Copy this file to ".env". Never commit ".env".
#
# The ONLY values you need to change are OPENAI_API_KEY (and OPENAI_MODEL if needed).
# Leave everything else as it is.

# Leave these as they are. They match the Docker Compose MySQL (docker compose up -d mysql),
# which listens on port 3307 on your computer. Full Docker (docker compose up) ignores
# the DB_* lines: Compose overrides them (inside Docker the database is mysql:3306).
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=ai_chat

# Origin of the React dev server (used for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# OpenAI (backend only - never expose these to the frontend)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
